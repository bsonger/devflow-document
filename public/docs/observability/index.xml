 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;service.namespace&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;string&lt;/td&gt;
 &lt;td&gt;服务命名空间&lt;/td&gt;
 &lt;td&gt;&lt;code&gt;payments&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;Metric / Log / Trace&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;deployment.environment&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;string&lt;/td&gt;
 &lt;td&gt;部署环境&lt;/td&gt;
 &lt;td&gt;&lt;code&gt;prod&lt;/code&gt; / &lt;code&gt;staging&lt;/code&gt; / &lt;code&gt;dev&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;Metric / Log / Trace&lt;/td&gt;
 &lt;/tr&gt;
 &lt;/tbody&gt;
&lt;/table&gt;
&lt;hr&gt;
&lt;h2 id="kubernetes-相关-attributes公共"&gt;Kubernetes 相关 Attributes（公共）&lt;a class="anchor" href="#kubernetes-%e7%9b%b8%e5%85%b3-attributes%e5%85%ac%e5%85%b1"&gt;#&lt;/a&gt;&lt;/h2&gt;
&lt;table&gt;
