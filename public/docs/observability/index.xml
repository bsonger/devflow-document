 &lt;td&gt;Metric / Log / Trace&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;k8s.container.name&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;string&lt;/td&gt;
 &lt;td&gt;容器名称&lt;/td&gt;
 &lt;td&gt;&lt;code&gt;devflow&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;Metric / Log / Trace&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;k8s.node.name&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;string&lt;/td&gt;
 &lt;td&gt;节点名称&lt;/td&gt;
 &lt;td&gt;&lt;code&gt;node-01&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;Metric / Log / Trace&lt;/td&gt;
 &lt;/tr&gt;
 &lt;/tbody&gt;
&lt;/table&gt;
&lt;hr&gt;
&lt;h2 id="请求信息"&gt;请求信息&lt;a class="anchor" href="#%e8%af%b7%e6%b1%82%e4%bf%a1%e6%81%af"&gt;#&lt;/a&gt;&lt;/h2&gt;
&lt;table&gt;
 &lt;thead&gt;
 &lt;tr&gt;
 &lt;th&gt;标签&lt;/th&gt;
